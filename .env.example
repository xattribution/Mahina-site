# Public address of the site, used for links inside emails
SITE_URL=https://mahinaclub.example.org

# Port on this machine, and which address to listen on (127.0.0.1 = only a proxy on this machine can reach it)
MAHINA_PORT=8080
MAHINA_BIND=0.0.0.0

# IP of your reverse proxy (Nginx Proxy Manager), so rate limits see real visitor addresses.
# The default trusts this machine and Docker's own networks; add your proxy's IP if it runs elsewhere.
# Only that proxy is trusted to set X-Forwarded-For. Comma-separate several.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# Signs single sign-on state. Generated and stored automatically if left blank.
SECRET_KEY=

# First admin (created on first start if it doesn't exist). Or leave blank and set up at /login.
# Passwords need 15+ characters, any kind; common and breached passwords are refused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Single sign-on with any OpenID Connect provider (Pocket ID, Authentik, Authelia, Keycloak, Google, Entra).
# Redirect URI to register with the provider: <SITE_URL>/api/admin/sso/callback
# Only emails already added as admins can sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Pocket ID
# Set to 0 to turn off password sign-in once single sign-on works
PASSWORD_LOGIN=1
# Set to 0 to skip the Have I Been Pwned check on new passwords
PASSWORD_BREACH_CHECK=1

# Email over SMTP. Any provider works. These override Settings > Email in the dashboard.
# Brevo:    smtp-relay.brevo.com  587 starttls
# Resend:   smtp.resend.com       465 ssl   (user: resend, password: API key)
# SendGrid: smtp.sendgrid.net     587 starttls (user: apikey, password: API key)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to 1 to load the sample events, photos and polls into an empty database
MAHINA_SEED=0
